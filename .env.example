# Local development only. Set these before the first database initialization.
POSTGRES_PASSWORD=local_admin_change_me
AGENT_DB_PASSWORD=local_agent_change_me
AGENT_RO_PASSWORD=local_reader_change_me
POSTGRES_PORT=5432

# Host-side scripts (Compose supplies its own host and port).
PGHOST=localhost
PGPORT=5432
PGUSER=olist_admin
PGDATABASE=olist

# OpenAI-compatible Chat Completions endpoint used in Step 2.
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=
# Alternatively set all three DEEPSEEK_API_KEY / DEEPSEEK_BASE_URL /
# DEEPSEEK_MODEL; explicit DeepSeek settings take precedence over OPENAI_*.
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_REVISION=5617a9f61b028005a4858fdac845db406aefb181
# Model service always uses HF_ENDPOINT=https://hf-mirror.com and volume /models.
EMBEDDING_API_KEY=
RAG_MODE=inject
AGENT_MODE=single
USE_MEMORY=true
SMALL_MODEL=
# Generate a separate random secret of at least 32 characters for the memory API.
MEMORY_API_SECRET=

# Optional independent attribution judge. Agent calls still run with judge off.
EVAL_ADAPTER=zero
EVAL_JUDGE=off
EVAL_JUDGE_MODEL=
# Provider-confirmed USD prices; blank means unknown, never a guessed price.
EVAL_INPUT_PRICE_PER_MILLION=
EVAL_OUTPUT_PRICE_PER_MILLION=

# Generate once: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Required by the MCP server; do not commit the real token.
MCP_BEARER_TOKEN=
MCP_URL=http://localhost:8001/mcp
SCHEMA_MODE=on_demand
MAX_STEPS=20
TOKEN_BUDGET=100000
MODEL_TIMEOUT=60
MODEL_MAX_OUTPUT_TOKENS=4096
CONTEXT_STRATEGY=none
CONTEXT_KEEP_TURNS=2
CONTEXT_SUMMARY_THRESHOLD=6000
CONTEXT_LIMIT=16000

# One rewrite then replace unsupported report numbers
NUMBER_GATE=true
RETRIEVAL_METHOD=vector

FINDING_MIN_SIMILARITY=0.78
WORKER_LEASE_SECONDS=30
PRODUCT_TOKEN_BUDGET=100000
