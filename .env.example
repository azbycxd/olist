# Local development only. Set these before the first database initialization.
POSTGRES_PASSWORD=local_admin_change_me
AGENT_DB_PASSWORD=local_agent_change_me
AGENT_RO_PASSWORD=local_reader_change_me
POSTGRES_PORT=5432

# Host-side scripts (Compose supplies its own host and port).
PGHOST=localhost
PGPORT=5432
PGUSER=olist_admin
PGDATABASE=olist

# Used in later steps; no model requests are made in Step 0.
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=
